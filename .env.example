# REQUIRED: Hopsworks SaaS credentials
HOPSWORKS_API_KEY=replace_me
HOPSWORKS_PROJECT=lahore_aqi_predictor
# Optional only for self-hosted Hopsworks:
# HOPSWORKS_HOST=my-instance.cloud.hopsworks.ai
# Recommended on Windows (create this folder first if needed):
# HOPSWORKS_CERT_FOLDER=C:/Users/yourname/hopsworks_certs

# Fixed Lahore configuration
CITY_NAME=Lahore
COUNTRY_NAME=Pakistan
LOCATION_NAME=Lahore, Pakistan
LATITUDE=31.5204
LONGITUDE=74.3587
LOCAL_TIMEZONE=Asia/Karachi

# Training/history window. The code clamps this to a maximum of 6 months.
HISTORY_MONTHS=6
RECENT_OVERLAP_DAYS=7
FORECAST_HOURS=72

# Hopsworks objects for this final six-month version
RAW_FEATURE_GROUP_NAME=lahore_aqi_raw_6m
RAW_FEATURE_GROUP_VERSION=1
FEATURE_GROUP_NAME=lahore_aqi_engineered_6m
FEATURE_GROUP_VERSION=1
FEATURE_VIEW_NAME=lahore_aqi_training_view_6m
FEATURE_VIEW_VERSION=1
MODEL_NAME=lahore_aqi_forecaster_6m
